{
  "name": "PuffinIT Dev Container",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "dockerComposeFile": ["../docker-compose.yml"],

  "service": "dev",
  "workspaceFolder": "/workspaces/wavr",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
    "version": "latest",
    "enableNonRootDocker": "true"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "black",
        "dotnet.defaultSolution": "disable",
        "dotnet.dotnetPath": "/usr/share/dotnet/dotnet",
        "remote.autoForwardPorts": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "yzhang.markdown-all-in-one",
        "SanjulaGanepola.github-local-actions",
        "shd101wyy.markdown-preview-enhanced",
        "usernamehw.errorlens",
        "PKief.material-icon-theme",
        "KevinRose.vsc-python-indent",
        "mhutchie.git-graph",
        "esbenp.prettier-vscode",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "humao.rest-client"
      ]
    }
  },

  "remoteEnv": {
    "DOTNET_ROOT": "/usr/share/dotnet",
    "PATH": "${containerEnv:PATH}:/usr/share/dotnet"
  },

  "postStartCommand": "sudo chown root:docker /var/run/docker-host.sock 2>/dev/null; sudo usermod -aG docker vscode 2>/dev/null; sudo chmod 660 /var/run/docker-host.sock 2>/dev/null || true",

  "forwardPorts": ["minio:9000", "minio:9001", 8000, 8080, "db:5432"],
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "portsAttributes": {
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "8000": { "label": "FastAPI Backend", "onAutoForward": "silent" },
    "8080": { "label": "MkDocs", "onAutoForward": "notify" },
    "9000": { "label": "MinIO API", "onAutoForward": "silent" },
    "9001": { "label": "MinIO Console", "onAutoForward": "notify" }
  },

  "containerEnv": {
    "PIP_ROOT_USER_ACTION": "ignore"
  },
  "runServices": ["db", "redis", "minio"],
  "shutdownAction": "stopCompose"
}
