FROM mcr.microsoft.com/devcontainers/python:3.12-bookworm

ENV PATH="/usr/local/bin:${PATH}"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Set project root early and ensure Python can import src
WORKDIR /workspaces/wavr
ENV PYTHONPATH=/workspaces/wavr

# Copy only requirements first for better caching
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# System deps and other setup (condensed)
RUN rm -f /etc/apt/sources.list.d/yarn.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends make gawk less locales git git-lfs build-essential curl procps wget ca-certificates openssh-client apt-transport-https software-properties-common \
 && rm -rf /var/lib/apt/lists/* \
 && update-ca-certificates \
 && git lfs install

RUN echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && locale-gen en_US.UTF-8

# Copy project files
COPY . /workspaces/wavr

ARG APP_USER=app
ARG APP_UID=1000
RUN id -u ${APP_USER} >/dev/null 2>&1 || useradd -m -u ${APP_UID} ${APP_USER}
USER ${APP_USER}
